<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AppScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Request Confirmed" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Your booking request has been validated. This is a prototype, so no booking has been saved." />

        <TextView
            android:id="@+id/txtConfirmationDetails"
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Booking details will appear here."
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnConfirmationHome"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Return to Home" />

    </LinearLayout>

</ScrollView>
