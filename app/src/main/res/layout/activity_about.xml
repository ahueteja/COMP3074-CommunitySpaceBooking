<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AppScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About" />

        <TextView
            style="@style/AppSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Community Space Booking App" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This application helps community members browse shared facilities, view facility information, and create booking requests." />

        <TextView
            style="@style/AppSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course Information" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COMP3074 - Mobile Application Development I" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="George Brown College" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Group: P 51" />

        <TextView
            style="@style/AppSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Developer Information" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anthony Huete-Jacobs" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID: 101570138" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version 1.0 - UI Prototype" />

        <Button
            android:id="@+id/btnAboutBack"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Home" />

    </LinearLayout>
</ScrollView>
