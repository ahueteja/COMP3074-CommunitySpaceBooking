<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AppScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Facility Details" />

        <TextView
            android:id="@+id/txtFacilityName"
            style="@style/AppSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Community Hall" />

        <TextView
            android:id="@+id/txtCapacity"
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capacity: 150 people" />

        <TextView
            android:id="@+id/txtLocation"
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: Main community complex" />

        <TextView
            android:id="@+id/txtDescription"
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Large multi-purpose space for meetings and community events." />

        <TextView
            android:id="@+id/txtHours"
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sample hours: 8:00 AM - 10:00 PM" />

        <Button
            android:id="@+id/btnBookSpace"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book This Space" />

        <Button
            android:id="@+id/btnBack"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Facilities" />

    </LinearLayout>
</ScrollView>
