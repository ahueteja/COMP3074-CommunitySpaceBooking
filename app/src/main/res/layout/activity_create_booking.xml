<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AppScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Booking" />

        <TextView
            android:id="@+id/txtSelectedFacility"
            style="@style/AppSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Facility: Community Hall" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Date" />

        <Button
            android:id="@+id/btnSelectDate"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Booking Date" />

        <TextView
            style="@style/AppBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Time" />

        <Button
            android:id="@+id/btnStartTime"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Start Time" />

        <Button
            android:id="@+id/btnEndTime"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select End Time" />

        <EditText
            android:id="@+id/edtAttendees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of attendees"
            android:inputType="number"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtPurpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Purpose / Notes"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSubmitBooking"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Booking" />

        <Button
            android:id="@+id/btnCancelBooking"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Facility" />

    </LinearLayout>
</ScrollView>
