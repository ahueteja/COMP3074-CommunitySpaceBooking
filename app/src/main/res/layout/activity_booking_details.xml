<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Booking Details"
            android:textSize="26sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <TextView
            android:id="@+id/txtBookingInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking information"
            android:textSize="18sp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnCancelSelectedBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel Booking (Prototype)" />

        <Button
            android:id="@+id/btnBackToBookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to My Bookings" />

    </LinearLayout>
</ScrollView>