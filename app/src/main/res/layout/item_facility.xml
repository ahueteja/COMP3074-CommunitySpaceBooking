<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtFacilityIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="🏢"
        android:textSize="27sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/txtItemFacilityName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Community Hall"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtItemFacilityDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Community events and gatherings"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtItemFacilityCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capacity: 150 people"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="›"
        android:textSize="30sp" />

</LinearLayout>
