<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_facility_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtFacilityIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/app_soft_purple"
        android:gravity="center"
        android:text="🏢"
        android:textSize="25sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/txtItemFacilityName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Community Hall"
            android:textColor="@color/app_heading"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtItemFacilityDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Community events and gatherings"
            android:textColor="@color/app_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtItemFacilityCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Capacity: 150 people"
            android:textColor="@color/app_primary"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/app_muted"
        android:textSize="28sp" />

</LinearLayout>
